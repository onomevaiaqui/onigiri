[Unit]
Description=Onigiri UDP motor controller
After=network.target

[Service]
Type=simple
User=onigiri
Group=onigiri
SupplementaryGroups=i2c
WorkingDirectory=/home/onigiri
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec python3 /home/onigiri/onigiri_udp_tank.py'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target

