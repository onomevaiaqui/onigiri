# Copy to /etc/onigiri/admin.env and configure for the validated Raspberry unit.
# ROS capture stays OFF until LiDAR, TF, odometry and SLAM YAML are validated.
ONIGIRI_MAPPING_ENABLED=0
ONIGIRI_LIDAR_ODOMETRY_ENABLED=0
ONIGIRI_MAPS_DIR=/home/onigiri/onigiri/data/maps
# ONIGIRI_SLAM_PARAMS=/home/onigiri/onigiri/config/slam-validated.yaml
# ONIGIRI_ROS_SETUP=/home/onigiri/robotica_ws/install/setup.bash
# ONIGIRI_ODOMETRY_SETUP=/home/onigiri/onigiri-odometry/rf2o-b38c68e/install/setup.bash

# Prévia RGB: somente assinatura ROS; iniciar driver separadamente.
ONIGIRI_CAMERA_PREVIEW_ENABLED=0
# ONIGIRI_CAMERA_COLOR_TOPIC=/camera/color/image_raw
# ONIGIRI_ORBBEC_SETUP=/home/onigiri/orbbec_ws/install/setup.bash

# Optional robot runtime; enabling the bridge alone never starts motors.
ONIGIRI_RUNTIME_ENABLED=0
ONIGIRI_MOTION_ENABLED=0
ONIGIRI_CAMERA_DRIVER_ENABLED=0
# ONIGIRI_CAMERA_DEPTH_TOPIC=/camera/depth/image_raw
# ONIGIRI_CAMERA_IMU_TOPIC=/camera/gyro_accel/sample

# ROS nodes run on the same Raspberry; panel access is through SSH.
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
