[Unit]
Description=Onigiri autonomous behavior (armed but stopped by default)
After=network.target onigiri-udp.service onigiri-lidar.service
Requires=onigiri-udp.service onigiri-lidar.service

[Service]
Type=simple
User=onigiri
Group=onigiri
WorkingDirectory=/home/onigiri
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec python3 /home/onigiri/onigiri_autonomous_basic.py'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
