[Unit]
Description=Onigiri LiDAR 2D ROS 2 driver
After=network.target

[Service]
Type=simple
User=onigiri
Group=onigiri
SupplementaryGroups=dialout
WorkingDirectory=/home/onigiri
EnvironmentFile=-/etc/onigiri/admin.env
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec /home/onigiri/onigiri/deploy/scripts/start_lidar.sh'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
