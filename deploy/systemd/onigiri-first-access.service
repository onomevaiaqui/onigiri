[Unit]
Description=Onigiri first access before robotics installation
After=onigiri-network.service
Requires=onigiri-network.service
ConditionPathExists=!/var/lib/onigiri/provisioned
[Service]
ExecStart=/usr/bin/python3 /opt/onigiri-network/network_agent.py --bootstrap
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
