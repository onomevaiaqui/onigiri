[Unit]
Description=Onigiri speech output
After=sound.target network.target

[Service]
Type=simple
User=onigiri
Group=onigiri
WorkingDirectory=/home/onigiri/onigiri
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec python3 software/raspberry/onigiri_speech.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
