[Unit]
Description=Onigiri local destination administration panel
After=network.target

[Service]
Type=simple
User=onigiri
Group=onigiri
WorkingDirectory=/home/onigiri/onigiri
Environment=PYTHONUNBUFFERED=1
# Local-only by design. Use an SSH tunnel to access it from a PC.
ExecStart=/home/onigiri/onigiri/.venv-admin/bin/python -m uvicorn app.main:app --app-dir software/admin_web --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
