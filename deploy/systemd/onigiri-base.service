[Unit]
Description=Onigiri Sabertooth base (explicit opt-in)
After=network.target
Conflicts=onigiri-udp.service
[Service]
Type=simple
User=onigiri
Group=onigiri
SupplementaryGroups=dialout
WorkingDirectory=/home/onigiri/onigiri
EnvironmentFile=-/etc/onigiri/admin.env
ExecStart=/bin/bash /home/onigiri/onigiri/deploy/scripts/base_worker.sh
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
